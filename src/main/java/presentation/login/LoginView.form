<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="presentation.login.LoginView">
  <grid id="a1b2c" binding="panel" layout-manager="GridLayoutManager" row-count="5" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="20" y="20" width="380" height="224"/>
    </constraints>
    <properties>
      <preferredSize width="380" height="220"/>
    </properties>
    <border type="line" title="Ingreso al Sistema"/>
    <children>
      <component id="d1e01" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <icon value="iconos/loginDialog.png"/>
          <text value="Identificador"/>
        </properties>
      </component>
      <component id="d1e02" class="javax.swing.JTextField" binding="idField">
        <constraints>
          <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
        </constraints>
        <properties/>
      </component>
      <component id="d1e03" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <icon value="iconos/clave.png"/>
          <text value="Clave"/>
        </properties>
      </component>
      <component id="d1e04" class="javax.swing.JPasswordField" binding="claveField">
        <constraints>
          <grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="150" height="-1"/>
          </grid>
        </constraints>
        <properties/>
      </component>
      <component id="d1e05" class="javax.swing.JButton" binding="ingresarButton" default-binding="true">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <icon value="iconos/login.png"/>
          <text value="Ingresar"/>
        </properties>
      </component>
      <component id="d1e06" class="javax.swing.JLabel" binding="mensajeErrorLabel">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="0" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <foreground color="-65536"/>
          <text value=""/>
        </properties>
      </component>
      <component id="6f1c6" class="javax.swing.JButton" binding="cambiarClaveButton">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Cambiar contraseña"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
